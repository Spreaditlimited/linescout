    "seo:migrate": "node --env-file=.env.local scripts/white-label-seo/migrate.cjs",
    "seo:seed-approved": "node --env-file=.env.local scripts/white-label-seo/seed-approved.cjs",
    "seo:plan": "node --env-file=.env.local scripts/white-label-seo/plan.cjs",
    "seo:import-drafts": "node --env-file=.env.local scripts/white-label-seo/import-drafts.cjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.0.7",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "docxtemplater": "^3.67.6",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.562.0",
    "mysql2": "^3.15.3",
    "next": "16.0.7",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
